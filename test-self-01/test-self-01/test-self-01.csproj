<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Gli avvisi diventano errori: il pacchetto non parte se il codice e' ambiguo. -->
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- Version e' la versione del prodotto; InformationalVersion puo' contenere il commit. -->
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<InformationalVersion>1.0.0-training</InformationalVersion>
	</PropertyGroup>

</Project>
